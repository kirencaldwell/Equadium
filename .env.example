# Backend (copy to .env). Everything here is optional: with none of it set the app runs
# guest-only and games live in memory.

# Where your Supabase project lives (Project Settings -> API -> Project URL).
SUPABASE_URL=https://your-project.supabase.co

# Verifying sign-in tokens. Set SUPABASE_URL (above) for projects that use the newer asymmetric
# signing keys; set the legacy shared secret too if your project still signs with HS256
# (Project Settings -> API -> JWT Secret). The API reads each token's algorithm and uses the right one.
SUPABASE_JWT_SECRET=

# Saving games and stats. Use the *service role* / secret key. SERVER ONLY: never put it in the
# frontend or commit it. Without it, saved games live in memory and are lost on restart.
SUPABASE_SERVICE_KEY=

# Comma-separated origins allowed to call the API from a browser (your Vercel URL). Defaults to *.
ALLOWED_ORIGINS=http://localhost:3000
