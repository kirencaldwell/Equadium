# Backend (copy to .env). Everything here is optional: with none of it set the app runs
# guest-only and games live in memory (lost on restart).

# Your Firebase project id (Firebase console -> Project settings -> General). Setting this turns
# sign-in verification on: the API then checks the Firebase ID token on every request.
FIREBASE_PROJECT_ID=your-project-id

# Service account for saving games and stats to Firestore: Project settings -> Service accounts ->
# Generate new private key. Paste the whole JSON as ONE LINE. SERVER ONLY: never put it in the
# frontend or commit it. (Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the key file's path.)
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated origins allowed to call the API from a browser (your Vercel URL). Defaults to *.
ALLOWED_ORIGINS=http://localhost:3000

# Local development against the Firestore emulator (`firebase emulators:start --only firestore`):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
