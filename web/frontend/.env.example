# Frontend (copy to web/frontend/.env). Vite bakes these in at build time, so rebuild/redeploy after changing them.

# URL of the hosted Equadium API (no trailing slash). Leave unset for local dev:
# `npm run dev` proxies /games, /rooms and /me to http://127.0.0.1:8000.
VITE_API_URL=

# Sign-in with Google: Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK config.
# These identify your project and are safe to expose in the browser. Leave unset to hide Sign in (guest-only).
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-app-id
