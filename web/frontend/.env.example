# Frontend (copy to web/frontend/.env). Vite bakes these in at build time, so rebuild/redeploy after changing them.

# URL of the hosted Equadium API (no trailing slash). Leave unset for local dev:
# `npm run dev` proxies /games, /rooms and /me to http://127.0.0.1:8000.
VITE_API_URL=

# Sign-in with Google (Project Settings -> API). The anon key is public by design; it is safe in the browser.
# Leave both unset to hide the Sign in button and run guest-only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
